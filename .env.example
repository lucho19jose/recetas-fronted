# Copy to .env.local for local overrides, or set the same name in Netlify.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Quasar loads .env.development for `quasar dev` and .env.production for `quasar build`.
# A variable set in the Netlify UI overrides the committed .env.production file.

# API origin, including the /api prefix and without a trailing slash.
VITE_API_BASE_URL=https://backend1-2-8gx9.onrender.com/api
